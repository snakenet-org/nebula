# ─────────────────────────────────────────────────────────────────────────────
# Nebula Vault environment configuration — copy to `.env` and fill in.
# All Nebula-owned variables use the NEBULA_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
NEBULA_HOST=0.0.0.0
NEBULA_PORT=8000
# Set to "yes" to enable uvicorn auto-reload in local development.
NEBULA_DEV=no
# Loguru sink level (also passed to uvicorn's own log_level). Defaults to ERROR in production
# (NEBULA_DEV=no), DEBUG under NEBULA_DEV=yes. Explicitly setting this always wins.
NEBULA_LOG_LEVEL=

# ── Shared service secret (X-Nebula-Token) ─────────────────────────────────
# Required on EVERY API request — both the SPA's own session calls and the external
# secret-retrieval API (api/v1/vault.py). Must be set when spawning the container.
NEBULA_TOKEN=change-me-shared-service-secret

# ── Master encryption key (REQUIRED — the app refuses to start without it) ──
# Every SecretValue is encrypted at rest under a key derived from this value (SHA-256 -> Fernet).
# Any string works — it does not need to already be a formatted Fernet key. Losing this value or
# changing it means every previously stored secret becomes permanently undecryptable — see
# docs/encryption.md. Generate a strong one, e.g.: `openssl rand -base64 32`
NEBULA_MASTER_KEY=change-me-to-a-long-random-passphrase

# ── Local username/password auth (HS256 JWT) — the optional admin login ────
NEBULA_JWT_SECRET=change-me-long-random-hs256-secret
NEBULA_JWT_TTL=3600
# Bootstrap admin, seeded on first start only if no users exist. Leave blank to skip.
NEBULA_ADMIN_USER=admin
NEBULA_ADMIN_PASS=change-me
NEBULA_ADMIN_EMAIL=admin@snakenet.org

# ── snakeNet ID (Authentik OIDC) ─────────────────────────────────────────────
# Used to validate Authentik RS256 access tokens. Leave blank to run local-auth only.
NEBULA_OIDC_JWKS_URL=https://id.snakenet.io/application/o/nebula/jwks/
NEBULA_OIDC_ISSUER=https://id.snakenet.io/application/o/nebula/
NEBULA_OIDC_AUDIENCE=
NEBULA_OIDC_GROUPS_CLAIM=groups
NEBULA_OIDC_AUTHORITY=https://id.snakenet.io
NEBULA_OIDC_APPLICATION_SLUG=nebula
NEBULA_OIDC_CLIENT_ID=

# ── Login screen feature flags ──────────────────────────────────────────────
# Set to "yes" to hide the username/password form. Default (unset) = shown.
NEBULA_BASIC_LOGIN_DISABLED=no
# Set to "no" to show the "Sign in with snakeNet ID" button. Default (unset) = hidden.
NEBULA_OIDC_LOGIN_DISABLED=yes
NEBULA_OIDC_LOGIN_CAPTION=Sign in with snakeNet ID

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# In the shipped Docker image Postgres runs INSIDE the same container (see entrypoint.sh) and only
# ever listens on 127.0.0.1 — these defaults are already correct for that image. Only override if
# you're running against an external Postgres in local development instead.
NEBULA_POSTGRES_HOST=localhost
NEBULA_POSTGRES_PORT=5432
NEBULA_POSTGRES_DB=nebula
NEBULA_POSTGRES_USER=postgres
NEBULA_POSTGRES_PASSWORD=nebula

# ── Data folder (the embedded Postgres data directory lives under here) ─────
NEBULA_DATA_FOLDER=./dev-data
